PORT=8081
DATABASE_URL=postgres://user:password@host:5432/casuya_sms
# Set to true on Render/Railway (managed Postgres requires SSL)
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Token expiry (default 1h). Options: 15m, 30m, 1h, 24h
JWT_EXPIRY=1h

# Optional: comma-separated list of allowed frontend origins (CORS)
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Optional: create the first admin account on startup (min 8 chars, include uppercase+lowercase+number)
# ADMIN_EMAIL=admin@casuya.sms
# ADMIN_PASSWORD=Change-Me-123!

# Optional: frontend URL for password reset links
# FRONTEND_URL=http://localhost:5173

# Set to "production" in production
# NODE_ENV=development
