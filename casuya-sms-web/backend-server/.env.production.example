# ===========================================
# CASUYA SMS WEB - PRODUCTION ENVIRONMENT
# ===========================================

# --- Database ---
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/casuya_sms?sslmode=require

# --- JWT ---
# Generate a strong secret (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your-super-secret-random-string-here-min-32-chars
JWT_EXPIRY=1h

# --- CORS ---
# Comma-separated list of allowed origins (your Vercel URL)
CORS_ORIGINS=https://your-app.vercel.app

# --- Admin ---
ADMIN_EMAIL=admin@casuyasms.com
ADMIN_PASSWORD=YourStrongPassword123!

# --- Server ---
NODE_ENV=production
PORT=8081
# Railway automatically sets PORT, but you can override

# --- Trust Proxy ---
TRUST_PROXY=true
